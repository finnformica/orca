# Copy to `.env` (gitignored, auto-loaded by Bun). Per-machine config only.

# REQUIRED. Base dir holding the repos listed in orca.config.ts — their paths resolve against it,
# so the config needs no editing on a new laptop. The bridge fails loudly at startup if unset.
ORCA_DEV_ROOT=$HOME/Documents/dev

# REQUIRED for Slack notify/bump. User token (xoxp…) — posts the message VERBATIM from your identity
# via chat.postMessage, deterministic and instant, the one path for every provider. Without it a send
# fails with a clear error (and copies the message to your clipboard so you can paste it manually).
# SLACK_TOKEN=xoxp-...

# Optional overrides:
# ORCA_STATE_DIR=$HOME/.orca   # lease + ledger dir (kept out of every worktree)
# ORCA_API_PORT=8787           # local bridge port
# ORCA_UI_PORT=8788            # Vite dev UI port

# Deployed instance (see README "Deploy"). Two instances share one database; each says who it is.
# ORCA_INSTANCE=cloud          # this process's name; repos with `runsOn: "cloud"` execute here.
#                              # Defaults to the machine's hostname.
# ORCA_BIND=127.0.0.1,100.64.0.5 # listen address(es), comma-separated. Default 127.0.0.1. A server or a laptop
#                              # another instance must reach binds loopback PLUS its tailnet address,
#                              # "127.0.0.1,<tailnet ip>" — loopback for bin/orca and Vite's /api proxy on the
#                              # machine itself. Never 0.0.0.0: the API has no auth of its own.
# ORCA_PREVIEW_HOST=orca-box   # host previews are reachable at from your browser (default localhost)
# ORCA_PREVIEW_BIND=0.0.0.0    # address preview services listen on — `{bind}` in a preview command (default 127.0.0.1;
#                              # on a box reached over the tailnet, 0.0.0.0 or its tailnet ip)
# ORCA_USER=me                 # row owner in the database until real auth exists (default "me")
# ORCA_IMDS_URL=http://169.254.169.254  # EC2 metadata service, for the machine-cost estimate (tests point it at a fake)
# ORCA_BOOT_ID_FILE=/proc/sys/kernel/random/boot_id  # kernel boot id, for the uptime ledger behind the machine cost (tests point it at a fake)

# Postgres holds the chat history and (soon) the per-repo config — see server/db.ts. Any reachable
# Postgres works; create the database once with `createdb orca`.
ORCA_DATABASE_URL=postgres://localhost:5432/orca
# A bridge run from a git WORKTREE refuses to apply migrations (a worktree's copied .env usually names
# the shared database, and a migration id is reserved only by merging to main). Set this only when
# this worktree's ORCA_DATABASE_URL is a database of its own. `bun run db:check` shows the ledger.
# ORCA_ALLOW_WORKTREE_MIGRATIONS=1
# Degraded mode: the bridge boots and runs agents without the database (turns journal to
# ~/.orca/outbox and replay when it is back). One connect attempt waits at most this many seconds;
# the background reconnect backs off exponentially up to the cap (ms).
# ORCA_DB_CONNECT_TIMEOUT_S=5
# ORCA_DB_RETRY_MAX_MS=30000
# Set by scripts/preview-orca.sh only: this bridge is an Orca-repo preview's /api — the branch's code
# reading the shared database, read-only (no migrations, no publishing, every write route refused).
# ORCA_PREVIEW_BRIDGE=1
# One bridge per instance runs the background duties (server/primary.ts): the holder of the
# instance's Postgres advisory lock. A bridge whose code is under .worktrees/ never contends for it
# unless this is set (a test's own bridges). A secondary retries the lock this often (ms), and every
# bridge checks this often (ms) that its own source directory still exists — gone, it exits.
# ORCA_PRIMARY=1
# ORCA_PRIMARY_RETRY_MS=5000
# ORCA_SOURCE_WATCH_MS=20000
# The headless browser the screenshot service (server/screenshot.ts, `orca-shot`) drives; default:
# the newest Playwright chrome-headless-shell in ~/.cache/ms-playwright, else one on PATH.
# ORCA_SHOT_BROWSER=/path/to/chrome-headless-shell
# The test suite runs against the SAME engine rather than a stand-in, so it proves what ships. Each
# test file gets a throwaway schema (tests/pg.ts), so point this at any Postgres you don't mind
# temporary schemas appearing in.
ORCA_TEST_DATABASE_URL=postgres://localhost:5432/postgres
