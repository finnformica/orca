# systemd unit for the deployed bridge — a TEMPLATE with two slots, orca@a and orca@b, so a deploy
# starts the new build in the idle slot beside the running one (both on 8787: ORCA_REUSE_PORT=1 in
# .env) and stops the old slot only once the new one answers (deploy/autodeploy.sh). Exactly one
# slot is enabled at a time. Install:
#
#   sudo cp deploy/orca@.service /etc/systemd/system/orca@.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now orca@a
#   journalctl -u orca@a -u orca@b -f
#
# Assumes a checkout at /opt/orca owned by a user `orca` who has run `bun install`, `bun run build`,
# and signed in each CLI (`claude login`, `codex login --device-auth`, `gh auth login`) — see README
# "Deploy". Bun auto-loads /opt/orca/.env, so every ORCA_* setting lives there, not here.
#
# Memory headroom (see CLAUDE.md "Deploying" and server/cgroup.ts): EVERY agent run gets its own
# memory-limited systemd scope, so one worker's runaway build/browser is killed on its own — but
# that only bounds ONE run at a time, not the box's bun process itself (previews, git, gh, anything
# it runs directly) nor the aggregate of many workers at once. MemoryMax below reserves ~15% of the
# box's RAM for Postgres, Tailscale and the kernel, which live OUTSIDE this unit (separate systemd
# units, never children of it) and must never be the one the kernel picks when memory gets tight.
# OOMScoreAdjust makes the bridge itself the LAST thing the kernel's system-wide OOM killer would
# pick if it ever has to look outside a single run's own scope. Sized for the default m7i.xlarge
# (16GB, deploy/provision.sh) — adjust both if the box's RAM changes.
[Unit]
Description=Orca bridge (slot %i)
After=network-online.target
Wants=network-online.target

[Service]
User=orca
WorkingDirectory=/opt/orca
# The CLIs install under the user's home; the unit's PATH is not the login shell's.
# ~/.hydra/bin FIRST: that is hydra's `claude` shim, which picks the login with the most headroom per
# launch (CLAUDE.md "Handover ladder"). Without it every run on the box landed on the default login
# unrouted — /api/usage reported `routing.shim: false`.
Environment=PATH=/home/orca/.hydra/bin:/home/orca/.bun/bin:/home/orca/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/home/orca
ExecStart=/home/orca/.bun/bin/bun run server/index.ts
Restart=always
RestartSec=3
# ~85% of 16GB — the bridge plus anything it runs directly (previews, one-off git/gh calls); each
# agent run is capped separately in its own scope (server/cgroup.ts) and is not part of this number.
MemoryMax=13G
OOMScoreAdjust=-500
# SIGTERM is "a deploy, a reboot": the bridge drains its history writes and leaves preview servers
# running (server/index.ts). Give it the drain window before systemd escalates.
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
